--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Cutscene_ko-KR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: fd8513ac7884b2d4995e539561afdc7c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 7127695360
    m_Localized: "\uC624\uB798\uC804, \uD55C \uC655\uAD6D\uC774 \uBC88\uC601\uC744
      \uB204\uB9AC\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 92829908992
    m_Localized: "\uD558\uC9C0\uB9CC \uADF8 \uD3C9\uD654\uB294 \uC624\uB798\uAC00\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4..."
    m_Metadata:
      m_Items: []
  - m_Id: 101889605632
    m_Localized: "\uC5B4\uB290 \uB0A0, \uC5B4\uB460\uACFC \uD568\uAED8 \uB9C8\uC655\uC774
      \uB098\uD0C0\uB0AC\uACE0,\r\n\uC655\uAD6D\uC740 \uC21C\uC2DD\uAC04\uC5D0 \uC808\uB9DD\uC5D0
      \uD729\uC2F8\uC600\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 111125463040
    m_Localized: "\uD76C\uB9DD\uC774 \uC0AC\uB77C\uC9C4 \uADF8\uB54C,\r\n\uC655\uC774
      \uD55C \uC0AC\uB78C\uC744 \uBD88\uB800\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 121686720512
    m_Localized: "\"\uB124\uAC8C \uC6A9\uC0AC\uC758 \uC774\uB984\uC744 \uC218\uC5EC\uD558\uB178\uB77C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 129530068992
    m_Localized: "\uC655\uC740 \uB9C8\uC9C0\uB9C9 \uD76C\uB9DD\uC744 \uAC78\uACE0,\r\n\uB2E8
      \uD55C \uBA85\uC758 \uC804\uC0AC\uB97C \uC138\uC0C1\uC5D0 \uB0B4\uBCF4\uB0C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 269967949824
    m_Localized: "\uADF8\uB9AC\uACE0 \uC9C0\uAE08\u2014\r\n\uADF8 \uC6A9\uC0AC\uC758
      \uC5EC\uC815\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2775847699742720
    m_Localized: "\uC6A9\uC0AC\uB2D8, \uC218\uACE0 \uB9CE\uC73C\uC2ED\uB2C8\uB2E4!\r\n\uC800\uD76C\uB294
      \uC6A9\uC0AC\uB2D8\uC758 \uD6C8\uB828\uC744 \uB3C4\uC6B8 \uB9B0 & \uB9AC\uC0AC
      \uC790\uB9E4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2775870026022912
    m_Localized: "\uB9C8\uC655\uC744 \uBB3C\uB9AC\uCE58\uAE30 \uC704\uD55C \uC6A9\uC0AC\uB2D8\uC758
      \uBAA8\uD5D8\uC5D0 \uD544\uC694\uD55C \uAE30\uCD08 \uC9C0\uC2DD\uC744 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2775877923897344
    m_Localized: "\uC6B0\uC120 \uC774\uB3D9 \uBC29\uBC95\uC5D0 \uB300\uD574\uC11C
      \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!\r\n\uD654\uBA74\uC758 \uBC84\uD2BC\uC744
      \uC81C\uC678\uD55C \uACF3\uC5D0 \uD130\uCE58\uB97C \uC720\uC9C0\uD558\uC2DC\uBA74
      \uCE90\uB9AD\uD130\uAC00 \uD574\uB2F9 \uBC29\uD5A5\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2775893728034816
    m_Localized: "\uC81C\uAC00 \uD654\uBA74\uC5D0 \uBAA9\uC801\uC9C0\uB97C \uD45C\uC2DC\uD574\uB4DC\uB9B4\uD14C\uB2C8,
      \uD574\uB2F9 \uC7A5\uC18C\uB85C \uC774\uB3D9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2775906629713920
    m_Localized: "\uC815\uB9D0 <size=110%>\uD6CC\uB96D\uD569\uB2C8\uB2E4</size> \uC6A9\uC0AC\uB2D8!\r\n\uC124\uC815\uC5D0\uC11C
      \uC774\uB3D9 \uBC29\uC2DD\uC744 \uBC14\uAFC0 \uC218 \uC788\uC73C\uB2C8 \uD55C
      \uBC88 \uD655\uC778\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2775914577920000
    m_Localized: "\uD654\uBA74 \uC0C1\uB2E8\uC758 \uAC8C\uC774\uC9C0 \uBC14\uAC00
      \uBCF4\uC774\uC2DC\uB098\uC694?\r\n\uC774 \uBC14\uB294 \uC704\uD5D8\uB3C4 \uAC8C\uC774\uC9C0
      \uB77C\uACE0 \uD558\uB294\uB370, \uC6A9\uC0AC\uB2D8\uC774 \uC774\uB3D9\uD558\uC2E4
      \uB54C\uB9C8\uB2E4 \uC810\uC810 \uCC28\uC624\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2775930671464448
    m_Localized: "\uC704\uD5D8\uB3C4\uAC00 \uCC28\uC624\uB974\uB294 \uC591\uC740
      \uBAAC\uC2A4\uD130\uC640 \uC6A9\uC0AC\uB2D8\uC758 \uB808\uBCA8\uC5D0 \uB530\uB77C
      \uB2EC\uB77C\uC9C0\uACE0,\r\n\uC704\uD5D8\uB3C4\uAC00 \uB192\uC544\uC9C8\uC218\uB85D
      \uBAAC\uC2A4\uD130\uC640 \uB9C8\uC8FC\uCE60 \uD655\uB960\uC774 \uB192\uC544\uC9C0\uAC8C
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2851746344337408
    m_Localized: "\uC815\uB9D0 <size=110%>\uD6CC\uB96D\uD558\uACE0, \uB6F0\uC5B4\uB098\uC2ED\uB2C8\uB2E4</size>
      \uC6A9\uC0AC\uB2D8!\r\n\uBC29\uAE08 \uCCB4\uD5D8\uD558\uC167\uB4EF\uC774, \uC804\uD22C\uB294
      \uC790\uB3D9\uC73C\uB85C \uC774\uB904\uC9D1\uB2C8\uB2E4.\r\n\uC6A9\uC0AC\uB2D8\uACFC
      \uBAAC\uC2A4\uD130\uAC00 \uBC88\uAC08\uC544\uC11C \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2851736588386304
    m_Localized: "\uC774\uB3D9\uC744 \uD1B5\uD574 \uC704\uD5D8\uB3C4 \uAC8C\uC774\uC9C0\uB97C
      \uB192\uC5EC \uBAAC\uC2A4\uD130\uC640 \uC804\uD22C\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2852408792711168
    m_Localized: "\uBC30\uD2C0\uD3EC\uC778\uD2B8\uAC00 <color=#F13A4E>0</color>\uC774
      \uB418\uBA74 \uC6A9\uC0AC\uB2D8\uC740 \uD798\uC774 \uB2E4\uD574 \uC4F0\uB7EC\uC9C0\uAC8C
      \uB429\uB2C8\uB2E4.\r\n30\uC73C\uB85C \uD55C\uC815\uB41C \uBC30\uD2C0\uD3EC\uC778\uD2B8\uB97C
      \uD604\uBA85\uD558\uAC8C \uC0AC\uC6A9\uD558\uB294\uAC83\uC774 \uC911\uC694\uD558\uACA0\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2852407261790208
    m_Localized: "\uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD558\uBA74 \uBC30\uD2C0\uD3EC\uC778\uD2B8\uAC00
      <color=#F13A4E>1</color>\uB9CC\uD07C \uAC10\uC18C\uD558\uACE0,\r\n\uD328\uBC30\uD558\uBA74
      \uBC30\uD2C0\uD3EC\uC778\uD2B8\uAC00 <color=#F13A4E>3</color>\uB9CC\uD07C \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2852876910592000
    m_Localized: "\uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD558\uBA74 \uB808\uBCA8\uC774
      \uC624\uB974\uACE0, \uB808\uBCA8\uB2F9 <color=#45b0f7>4</color>\uC758 \uC2A4\uD0EF
      \uD3EC\uC778\uD2B8\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2852884384841728
    m_Localized: "\uAC01 \uC2A4\uD0EF \uC606\uC758 <color=#45b0f7>+</color> \uBC84\uD2BC\uC744
      \uB20C\uB7EC \uC2A4\uD0EF\uC744 \uD22C\uC790\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uCC98\uC74C\uC5D0\uB294
      LUC\uC744 \uD22C\uC790\uD558\uC9C0 \uC54A\uACE0, HP, ATK, DEF\uB9CC\uC744 \uADE0\uD615\uC788\uAC8C
      \uD22C\uC790\uD558\uB294 \uAC78 \uCD94\uCC9C\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3133915335753728
    m_Localized: "\uC6A9\uC0AC\uB2D8\uC758 \uBB34\uC6B4\uC744 \uBE4C\uACA0\uC2B5\uB2C8\uB2E4.
      \uBD80\uB514 \uB9C8\uC655\uC744 \uBB3C\uB9AC \uC8FC\uC2ED\uC2DC\uC624!"
    m_Metadata:
      m_Items: []
  - m_Id: 2854499225436160
    m_Localized: "\uD6CC\uB96D\uD569\uB2C8\uB2E4! \uBAA8\uB4E0 \uC2A4\uD0EF \uD3EC\uC778\uD2B8\uB97C
      \uD22C\uC790\uD558\uC168\uB124\uC694.\r\n\uC55E\uC73C\uB85C \uB808\uBCA8\uC5C5\uD560
      \uB54C\uB9C8\uB2E4 \uC2A4\uD0EF \uD3EC\uC778\uD2B8\uAC00 \uC790\uB3D9\uC73C\uB85C
      \uBD84\uBC30\uB418\uB3C4\uB85D \uC124\uC815\uD560 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC790\uB3D9
      \uBD84\uBC30 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC124\uC815\uD574\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 2863382492872704
    m_Localized: "\uC815\uB9D0 <size=110%>\uD6CC\uB96D\uD558\uACE0, \uB6F0\uC5B4\uB098\uC2DC\uACE0,
      \uB300\uB2E8\uD558\uC2ED\uB2C8\uB2E4</size> \uC6A9\uC0AC\uB2D8!\r\n\uC2A4\uD0EF
      \uC911 LUC(\uD589\uC6B4) \uC2A4\uD0EF\uC740 \uC804\uD22C\uC5D0\uB294 \uC9C1\uC811\uC801\uC73C\uB85C
      \uAD00\uC5EC\uD558\uC9C0 \uC54A\uC9C0\uB9CC, \uBAAC\uC2A4\uD130\uC5D0\uAC8C\uC11C
      \uB354 \uB9CE\uC740 \uB3C8\uC744 \uC5BB\uAC70\uB098 \uBAAC\uC2A4\uD130\uC758
      \uC804\uB9AC\uD488\uC744 \uB354 \uB192\uC740 \uD655\uB960\uB85C \uC5BB\uAC8C
      \uD574\uC900\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2879520270450688
    m_Localized: "\uAE30\uBCF8\uC801\uC778 \uAC83\uB4E4\uC740 \uBAA8\uB450 \uC124\uBA85\uC744
      \uB4DC\uB9B0 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4 \uC6A9\uC0AC\uB2D8!"
    m_Metadata:
      m_Items: []
  - m_Id: 29277458202624000
    m_Localized: "\uC601\uC9C0\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD569\uB2C8\uB2E4
      \uC6A9\uC0AC\uB2D8!\r\n\uC774\uACF3\uC740 \uC6A9\uC0AC\uB2D8\uC774 \uD558\uC0AC\uBC1B\uC73C\uC2E0
      \uC601\uC9C0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29277588377042944
    m_Localized: "\uC601\uC9C0\uC5D0\uC11C \uC5EC\uB7EC \uC0C1\uC778\uB4E4\uC5D0\uAC8C
      \uAC00\uAE4C\uC774 \uC811\uADFC\uD558\uBA74 \uB9D0\uC744 \uAC70\uC2E4 \uC218
      \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 29277588788084736
    m_Localized: "\uC800\uC5D0\uAC8C \uB9D0\uC744 \uAC78\uC5B4 \uC601\uC9C0\uB97C
      \uC5C5\uADF8\uB808\uC774\uB4DC \uD574 \uBCF4\uC138\uC694!\r\n\uCC98\uC74C\uC5D0\uB294
      <color=#45b0f7>\uBB34\uB8CC</color>\uB85C \uC601\uC9C0\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC
      \uD574 \uB4DC\uB9B4\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 29308654248787968
    m_Localized: "\uC88B\uC544\uC694! \uC601\uC9C0\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC
      \uD588\uB354\uB2C8 \uC7A5\uBE44 \uC0C1\uC778\uC774 \uCC3E\uC544\uC654\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 29308698968457216
    m_Localized: "\uB2E4\uC591\uD55C \uC0C1\uC778\uB4E4\uACFC \uB300\uD654\uD574
      \uC120\uB300 \uC6A9\uC0AC\uB2D8\uAED8\uC11C \uBAA8\uC73C\uC2E0 \uB3C8\uC73C\uB85C
      \uC6A9\uC0AC\uB2D8\uC744 \uB2E8\uB828\uD558\uAC70\uB098, \uC0C8\uB85C\uC6B4
      \uC7A5\uBE44\uB97C \uAD6C\uB9E4\uD558\uC2E4 \uC218\uB3C4 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 29308687186657280
    m_Localized: "\uC601\uC9C0\uB97C \uAC00\uAFB8\uC2E4 \uB54C\uB9C8\uB2E4 \uC810\uC810
      \uB354 \uB2E4\uC591\uD55C \uC778\uBB3C\uB4E4\uC774 \uC601\uC9C0\uC5D0 \uBC29\uBB38\uD560
      \uAC70\uC5D0\uC694.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 29309554367397888
    m_Localized: "\uC900\uBE44\uAC00 \uB05D\uB098\uC2DC\uBA74 \uBAA8\uD5D8\uC744
      \uC2DC\uC791\uD574\uC8FC\uC138\uC694.\r\n\uC2DC\uC791\uD560 \uB54C \uAC00\uC9C0\uACE0
      \uACC4\uC2E0 <color=#F13A4E>\uACE8\uB4DC\uAC00 \uC804\uBD80 \uC0AC\uB77C\uC9C0\uAE30
      \uB54C\uBB38\uC5D0</color> \uC8FC\uC758\uD574\uC8FC\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 35470494146232320
    m_Localized: "\uC6E8\uC774\uD3EC\uC778\uD2B8\uB85C \uC774\uB3D9\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 35470623037194240
    m_Localized: "\uC774\uB3D9\uC744 \uD1B5\uD574 \uC704\uD5D8\uB3C4 \uAC8C\uC774\uC9C0\uB97C
      \uC99D\uAC00\uC2DC\uCF1C \uBAAC\uC2A4\uD130\uC640 \uC804\uD22C\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 35470736392454144
    m_Localized: "\uC2A4\uD0EF \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC2A4\uD0EF \uCC3D\uC744
      \uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 35473328967254016
    m_Localized: "\uB2E4\uC74C\uC73C\uB85C\uB294 \uBAAC\uC2A4\uD130\uC640\uC758 \uC804\uD22C\uC5D0
      \uB300\uD574 \uC124\uBA85\uD574\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 36168274162483200
    m_Localized: "\uBCF4\uC2A4\uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD558\uBA74 \uC720\uBB3C
      \uBCF4\uC0C1\uC744 \uC5BB\uC744 \uC218 \uC788\uC5B4\uC694.\r\n\uAC15\uD55C
      \uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD560\uC218\uB85D \uD68D\uB4DD \uAC00\uB2A5\uD55C
      \uC720\uBB3C\uC758 \uD76C\uADC0\uB3C4\uAC00 \uB192\uC544\uC9C4\uB2E4\uACE0
      \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 36168739491151872
    m_Localized: "LUC\uB97C \uD22C\uC790\uD560\uC218\uB85D \uBAAC\uC2A4\uD130\uC5D0\uAC8C
      \uC5BB\uC744 \uC218 \uC788\uB294 \uACE8\uB4DC\uAC00 \uC99D\uAC00\uD558\uB294\uB370,\r\n\uBAAC\uC2A4\uD130\uC758
      \uB808\uBCA8\uC774 \uB192\uC744\uC218\uB85D \uB354 \uB9CE\uC740 LUC\uC744 \uD22C\uC790\uD574\uC57C
      \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 36168969527754752
    m_Localized: "\uB0A8\uCABD\uC5D0\uB294 \uD53C\uB77C\uBBF8\uB4DC\uAC00 \uC788\uB2E4\uACE0
      \uD558\uB294\uB370,\r\n\uD53C\uB77C\uBBF8\uB4DC\uC5D0\uC11C\uB294 \uBAAC\uC2A4\uD130\uB4E4\uC774
      \uB354 \uB9CE\uC740 \uACE8\uB4DC\uB97C \uC900\uB2E4\uB294 \uC18C\uBB38\uC774
      \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 36169161664626688
    m_Localized: "\uB208\uC774 \uB0B4\uB9AC\uB294 \uACF3\uC5D0 \uC5BC\uC74C \uB3D9\uAD74\uB85C
      \uD1B5\uD558\uB294 \uBE44\uBC00 \uCD9C\uC785\uAD6C\uAC00 \uC788\uB2E4\uACE0
      \uD574\uC694.\r\n\uC785\uAD6C\uC758 \uC591 \uC606\uC5D0 \uB208\uC0AC\uB78C\uC774
      \uC788\uC5B4 \uC27D\uAC8C \uC54C\uC544\uBCFC \uC218 \uC788\uB2E4\uACE0 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 36169312189808640
    m_Localized: "\uBD89\uC740 \uC78E\uC758 \uB098\uBB34\uAC00 \uBB34\uC131\uD55C
      \uC74C\uC0B0\uD55C \uC232\uAE38, \uC544\uC8FC \uB0AE\uC740 \uD655\uB960\uB85C
      \uD76C\uADC0\uD55C \uBAAC\uC2A4\uD130\uC640 \uB9CC\uB0A0 \uC218 \uC788\uB2E4\uACE0
      \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 36169533401595904
    m_Localized: "\uB9C8\uC655\uC740 \uC790\uC2E0\uC744 \uC9C0\uD0A4\uB294 \uC0AC\uCC9C\uC655\uC744
      \uAC70\uB290\uB9AC\uACE0 \uC788\uB294\uB370, \uC0AC\uCC9C\uC655\uC744 \uCC98\uCE58\uD560\uC218\uB85D
      \uB9C8\uC655\uC774 \uC57D\uD654\uB41C\uB2E4\uB294 \uC18C\uBB38\uC774 \uB3CC\uB354\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 36169816882020352
    m_Localized: "\uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD558\uBA74 \uB0AE\uC740
      \uD655\uB960\uB85C \uC7A5\uBE44\uB97C \uC5BB\uC744\uC218\uB3C4 \uC788\uACE0,
      \uC0C8\uB85C\uC6B4 \uC720\uBB3C\uB3C4 \uBC1C\uACAC\uD560 \uC218 \uC788\uB2E4\uACE0
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 36391525883052032
    m_Localized: "\uAC19\uC740 \uC7A5\uBE44\uB97C \uC5EC\uB7EC\uBC88 \uC5BB\uAC8C
      \uB418\uBA74 \uC7A5\uBE44\uC758 \uD6A8\uACFC\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4.\r\n\uB2E4\uB9CC
      \uAC19\uC740 \uC7A5\uBE44\uB97C \uC5EC\uB7EC\uBC88 \uAD6C\uB9E4\uD558\uB824
      \uD558\uBA74 \uAC00\uACA9\uC774 \uC810\uC810 \uBE44\uC2F8\uC9C0\uB2C8 \uC8FC\uC758\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 36606240257212416
    m_Localized: "\uC5B4\uB5A4 \uC7A5\uBE44\uB4E4\uC740 \uAD6C\uB9E4\uD560 \uC218
      \uC5C6\uACE0, \uBAAC\uC2A4\uD130\uC758 \uB4DC\uB78D\uC73C\uB85C\uB9CC \uC5BB\uC744
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 43385586301009920
    m_Localized: "\"\uACE0\uC815 \uD53C\uD574\"\uB294 \uD53C\uD574\uB7C9 \uC99D\uAC00\uB098
      \uCE58\uBA85\uD0C0 \uB4F1\uC758 \uD6A8\uACFC\uB97C \uC801\uC6A9\uBC1B\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2852876910592001
    m_Localized: "\uD654\uBA74 \uC6B0\uCE21 \uC0C1\uB2E8\uC758 \uC2A4\uD0EF \uBC84\uD2BC\uC744
      \uB20C\uB7EC \uC2A4\uD0EF\uCC3D\uC744 \uC5F0 \uB4A4 \uC5BB\uC740 \uBAA8\uB4E0
      \uC2A4\uD0EF\uC744 \uD22C\uC790\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 35470736392454145
    m_Localized: "+ \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC2A4\uD0EF \uD22C\uC790 \uCC3D\uC744
      \uC5F4\uC5B4 \uBCF4\uC720\uC911\uC778 \uBAA8\uB4E0 \uC2A4\uD0EF \uD3EC\uC778\uD2B8\uB97C
      \uD22C\uC790\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 35470736392454146
    m_Localized: "\uC790\uB3D9 \uBD84\uBC30 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC790\uB3D9
      \uBD84\uBC30 \uC124\uC815 \uCC3D\uC744 \uC5F4\uACE0, \uC790\uB3D9 \uBD84\uBC30\uB97C
      On\uC73C\uB85C \uC124\uC815\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 44927660007620608
    m_Localized: "\uC804\uD22C\uB97C \uB9C8\uCCE4\uC744 \uB54C \uC77C\uC815\uD655\uB960\uB85C
      \uAC01 \uC9C0\uC5ED\uC5D0 \uD2B9\uC218 \uD6A8\uACFC\uAC00 \uBD80\uC5EC\uB41C\uB2E4\uACE0
      \uD574\uC694.\r\n\uAC00\uB054\uC529\uC740 \uD2B9\uC218\uD55C \uBAAC\uC2A4\uD130\uAC00
      \uB4F1\uC7A5\uD558\uB294 \uD6A8\uACFC\uAC00 \uBD80\uC5EC\uB418\uAE30\uB3C4
      \uD55C\uB2E4\uB2C8 \uC8FC\uC758\uD574\uC57C\uACA0\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000000
    m_Localized: "\uCCAB \uBCF4\uC2A4 \uCC98\uCE58\uB97C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4!\r\n\uC720\uBB3C
      \uBCF4\uC0C1\uC744 \uD68D\uB4DD\uD558\uC168\uB124\uC694. \uC720\uBB3C \uBCF4\uC0C1\uC5D0
      \uB300\uD574 \uC124\uBA85\uD574\uB4DC\uB9B4\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000001
    m_Localized: "\uC774\uACF3\uC5D0 \uD45C\uC2DC\uB41C \uC720\uBB3C \uC911 \uD558\uB098\uB97C
      \uC120\uD0DD\uD560 \uC218 \uC788\uC5B4\uC694.\r\n\uD558\uB098\uB97C \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000002
    m_Localized: "\uC774 \uC601\uC5ED\uC5D0\uC11C\uB294 \uC120\uD0DD\uD55C \uC720\uBB3C\uC758
      \uC774\uB984, \uB4F1\uAE09, \uD6A8\uACFC\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694.\r\n\uB4F1\uAE09\uC774
      \uB192\uC744\uC218\uB85D \uB354 \uAC15\uB825\uD55C \uD6A8\uACFC\uB97C \uAC00\uC9C0\uACE0
      \uC788\uB2F5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000003
    m_Localized: "\uC720\uBB3C\uC740 \uC804\uD22C\uC5D0\uC11C \uB3C4\uC6C0\uC774
      \uB418\uB294 \uD328\uC2DC\uBE0C \uD6A8\uACFC\uB97C \uC81C\uACF5\uD574\uC694.\r\n\uC790\uC2E0\uC758
      \uD50C\uB808\uC774 \uC2A4\uD0C0\uC77C\uC5D0 \uB9DE\uAC8C \uC2E0\uC911\uD788
      \uC120\uD0DD\uD574\uC8FC\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000004
    m_Localized: "\uB9CC\uC57D \uD604\uC7AC \uC720\uBB3C\uC774 \uB9C8\uC74C\uC5D0
      \uB4E4\uC9C0 \uC54A\uB294\uB2E4\uBA74,\r\n\uB9AC\uB864 \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uC0C8\uB85C\uC6B4 \uC720\uBB3C\uC744 \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000005
    m_Localized: "\uB9AC\uB864 \uD69F\uC218\uB294 \uC81C\uD55C\uB418\uC5B4 \uC788\uC73C\uB2C8
      \uC2E0\uC911\uD558\uAC8C \uC0AC\uC6A9\uD574\uC8FC\uC138\uC694.\r\n\uB9AC\uB864
      \uD69F\uC218\uB97C \uD558\uB098 \uB298\uB824 \uB4DC\uB9B4 \uD14C\uB2C8, \uB9AC\uB864
      \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 50002000000000000
    m_Localized: "\uBCF4\uC0C1 \uC720\uBB3C\uC744 \uC120\uD0DD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 50002000000000001
    m_Localized: "\uB9AC\uB864 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC0C8\uB85C\uC6B4
      \uC720\uBB3C\uC744 \uD655\uC778\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 50002000000000002
    m_Localized: "\uC0C8\uB85C\uC6B4 \uC720\uBB3C \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 50002000000000003
    m_Localized: "\uD68D\uB4DD \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC720\uBB3C\uC744
      \uD68D\uB4DD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000006
    m_Localized: "\uC798 \uD558\uC168\uC5B4\uC694! \uB9AC\uB864\uC5D0 \uC131\uACF5\uD588\uB124\uC694.\r\n\uC774\uC81C
      \uC720\uBB3C\uC744 \uC120\uD0DD\uD558\uACE0 \uD68D\uB4DD\uD574\uBD05\uC2DC\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000007
    m_Localized: "\uC720\uBB3C\uC744 \uD68D\uB4DD\uD558\uC168\uB124\uC694, \uCD95\uD558\uB4DC\uB824\uC694!\r\n\uD68D\uB4DD\uD55C
      \uC720\uBB3C\uC740 \uC2A4\uD0EF\uCC3D\uC5D0\uC11C \uD655\uC778\uD560 \uC218
      \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 50002000000000004
    m_Localized: "\uC2A4\uD0EF \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD68D\uB4DD\uD55C
      \uC720\uBB3C\uC744 \uD655\uC778\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000008
    m_Localized: "\uC774\uACF3\uC5D0 \uBCF4\uC720 \uC911\uC778 \uC720\uBB3C\uC774
      \uD45C\uC2DC\uB429\uB2C8\uB2E4.\r\n\uC720\uBB3C\uC740 \uB2E4\uC591\uD55C \uD328\uC2DC\uBE0C
      \uD6A8\uACFC\uB85C \uC804\uD22C\uB97C \uB3C4\uC640\uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 50001000000000009
    m_Localized: "\uC720\uBB3C \uD29C\uD1A0\uB9AC\uC5BC\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC5D0\uC694!\r\n\uBAA8\uD5D8\uC5D0\uC11C
      \uD589\uC6B4\uC744 \uBE55\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
