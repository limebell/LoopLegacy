  - m_Id: 27971668246265856
    m_Localized: "\uB370\uBAA8\uB2C9 \uC544\uBA38"
    m_Metadata:
      m_Items: []
  - m_Id: 32669487817293824
    m_Localized: "\uC624\uB798 \uCC29\uC6A9\uD558\uC5EC \uB2E4 \uD5E4\uC9C4 \uC637."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459648
    m_Localized: "\uAC00\uC8FD\uC744 \uC5EE\uC5B4 \uB9CC\uB4E0 \uBC29\uC5B4\uAD6C."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459649
    m_Localized: "\uAD6C\uB9AC\uB85C \uB9CC\uB4E0 \uD22C\uBC15\uD55C \uAC11\uC637."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459650
    m_Localized: "\uC0AC\uC2AC\uB85C \uAFF0\uB9E4\uC5B4 \uD65C\uB3D9\uC131\uC774
      \uC88B\uC740 \uAC11\uC637."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459651
    m_Localized: "\uAC70\uB300\uD55C \uCCA0\uD310\uC744 \uB367\uB300\uC5B4 \uB192\uC740
      \uBC29\uC5B4\uB825\uC744 \uC81C\uACF5\uD558\uB294 \uAC11\uC637."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459652
    m_Localized: "\uC911\uC138 \uAE30\uC0AC\uB4E4\uC774 \uCC29\uC6A9\uD588\uB2E4\uACE0
      \uC54C\uB824\uC9C4 \uAC00\uBCCD\uACE0 \uD2BC\uD2BC\uD55C \uAC11\uC637."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459653
    m_Localized: "\uAE09\uC18C\uB97C \uBCF4\uD638\uD558\uBA74\uC11C\uB3C4 \uADF9\uD55C\uC758
      \uD65C\uB3D9\uC131\uC744 \uC81C\uACF5\uD558\uB294 \uAC11\uC637."
    m_Metadata:
      m_Items: []
  - m_Id: 36952663301554176
    m_Localized: "\uB9C8\uC655\uC758 \uB85C\uBE0C"
    m_Metadata:
      m_Items: []
  - m_Id: 36952671786631168
    m_Localized: "\uB9C8\uC655\uC774 \uCC29\uC6A9\uD558\uB358 \uB85C\uBE0C. \uC0AC\uC545\uD55C
      \uAE30\uC6B4\uC774 \uB290\uAEF4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459660
    m_Localized: "\uB9C8\uC655\uAD70 \uC815\uC608 \uAC04\uBD80\uB4E4\uC744 \uC704\uD574
      \uC81C\uC791\uB41C \uAC11\uC637."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459654
    m_Localized: "\uBE44\uB2E8\uC73C\uB85C \uC9E0 \uBD80\uB4DC\uB7EC\uC6B4 \uB9DD\uD1A0.
      \uC801\uC758 \uACF5\uACA9\uC744 \uBD80\uB4DC\uB7FD\uAC8C \uD758\uB824\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459659
    m_Localized: "\uB9C8\uC655 \uC218\uD638\uAD70\uC774 \uBD80\uC5EC\uBC1B\uB294
      \uAE30\uCD08\uC801\uC778 \uAC11\uC637. \uC778\uAC04\uC740 \uAC10\uD788 \uB9CC\uB4E4
      \uC218 \uC5C6\uC744 \uC815\uB3C4\uB85C \uB2E8\uB2E8\uD558\uACE0 \uAC00\uBCCD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459658
    m_Localized: "\uBC24\uC758 \uAE30\uC6B4\uC744 \uB2F4\uC740 \uC11C\uB298\uD55C
      \uB9DD\uD1A0. \uC8FC\uC220\uC801\uC778 \uD798\uC73C\uB85C \uC0C1\uB300\uC758
      \uACF5\uACA9\uC744 \uC57D\uD654\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459656
    m_Localized: "\uC218\uB9CE\uC740 \uC804\uD22C \uACBD\uD5D8\uC73C\uB85C \uC778\uD574
      \uC801\uC758 \uD53C\uAC00 \uC2A4\uBA70\uB4E0 \uAC11\uC637. \uC218\uB9CE\uC740
      \uC6D0\uD55C\uC774 \uAE43\uB4E4\uC5B4 \uCC29\uC6A9\uC790\uB97C \uC800\uC8FC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459655
    m_Localized: "\uC0AC\uD30C\uC774\uC5B4\uB85C \uB9CC\uB4E0 \uC138\uB828\uB41C
      \uAC11\uC637."
    m_Metadata:
      m_Items: []
  - m_Id: 32669487842459657
    m_Localized: "\uC6A9\uC655\uC774 \uC785\uB358 \uAC78 \uBAB0\uB798 \uD6D4\uCCD0\uC628
      \uAC11\uC637. \uC6A9\uC655\uC758 \uB364\uBC99\uB300\uB294 \uC131\uACA9 \uD0D3\uC5D0
      \uC790\uC8FC \uB3C4\uB451\uB9DE\uC544 \uC138\uC0C1\uC5D0\uB294 \uC774 \uAC11\uC637\uC774
      10\uAC1C\uB098 \uC874\uC7AC\uD55C\uB2E4\uACE0 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  references:
