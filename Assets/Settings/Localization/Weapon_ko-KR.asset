  - m_Id: 27975007826608128
    m_Localized: "\uAC00\uC2DC \uCC44\uCC0D"
    m_Metadata:
      m_Items: []
  - m_Id: 27975067838709760
    m_Localized: "\uBBF8\uB178\uD0C0\uC6B0\uB974\uC2A4\uC758 \uB300\uAC80"
    m_Metadata:
      m_Items: []
  - m_Id: 27975104140410880
    m_Localized: "\uC0AC\uD30C\uC774\uC5B4 \uC2A4\uD0DC\uD504"
    m_Metadata:
      m_Items: []
  - m_Id: 27975112306720768
    m_Localized: "\uD30C\uAD34\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 27975118539456512
    m_Localized: "\uD65C?"
    m_Metadata:
      m_Items: []
  - m_Id: 27975124356956160
    m_Localized: "\uCC98\uD615\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 27975126932258816
    m_Localized: "\uD3ED\uD48D\uAD81"
    m_Metadata:
      m_Items: []
  - m_Id: 27979738615644160
    m_Localized: "\uC5D4\uC824\uB9AD \uAC74\uD2C0\uB9BF"
    m_Metadata:
      m_Items: []
  - m_Id: 32673007123562496
    m_Localized: "\uB098\uBB34\uB85C \uB9CC\uB4E0 \uCE7C. \uB9E8\uC190\uBCF4\uB2E4\uB294
      \uB0AB\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894144
    m_Localized: "\uC624\uB798\uB418\uC5B4 \uD22C\uBC15\uD55C \uAC80."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894145
    m_Localized: "\uAC00\uC7A5 \uC27D\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uB294 \uAD50\uACFC\uC11C\uC801\uC778
      \uBB34\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894146
    m_Localized: "\uC0AC\uC6A9\uAC10\uC774 \uB290\uAEF4\uC9C0\uB294 \uC624\uB798\uB41C
      \uB3C4\uB07C."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894147
    m_Localized: "\uB0A0\uC774 \uB450 \uAC1C \uB2EC\uB824\uC11C \uACF5\uACA9\uB825\uB3C4
      \uB450 \uBC30\uC778 \uB3C4\uB07C. \uC0AC\uC2E4 \uB450 \uBC30 \uAE4C\uC9C0\uB294
      \uC544\uB2C8\uB77C\uACE0 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894148
    m_Localized: "\uAE38\uACE0 \uC587\uACE0 \uB05D\uC774 \uBFB0\uC871\uD55C \uAC80.
      \uC0C1\uB2F9\uD788 \uAC00\uBCCD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894158
    m_Localized: "\uAE08\uC73C\uB85C \uB3C4\uAE08\uB41C \uD654\uB824\uD55C \uAC80.
      \uADF8 \uD654\uB824\uD568\uB9CC\uD07C \uAC15\uB825\uD55C \uACF5\uACA9\uB825\uC744
      \uC790\uB791\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894157
    m_Localized: "\uC624\uB518\uC774 \uC0AC\uC6A9\uD558\uB358 \uB0A0\uCE74\uB85C\uC6B4
      \uCC3D. \uC790\uC138\uD788 \uC0B4\uD3B4\uBCF4\uB2C8 \uC791\uAC8C TM\uC774\uB77C\uB294
      \uAE00\uC790\uAC00 \uBD99\uC5B4\uC788\uB2E4..."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894155
    m_Localized: "\uC138 \uAC08\uB798\uC758 \uB0A0\uC774 \uB2EC\uB9B0 \uB0A0\uCE74\uB85C\uC6B4
      \uBB34\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894153
    m_Localized: "\uBB34\uAC70\uC6B4 \uBA38\uB9AC\uAC00 \uB2EC\uB9B0 \uB454\uD0C1\uD55C
      \uB454\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894152
    m_Localized: "\uD070 \uCE7C\uB0A0\uB9CC\uD07C \uBB34\uAC70\uC6B4 \uAC80. \uC774\uAC83\uC5D0
      \uB9DE\uC740 \uC0C1\uB300\uB294 \uC73C\uAE68\uC9C4\uB2E4\uACE0 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894151
    m_Localized: "\uAC15\uCCA0\uB85C \uB9CC\uB4E0 \uAE38\uACE0 \uB0A0\uB835\uD55C
      \uAC80"
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894149
    m_Localized: "\uAE34 \uB9AC\uCE58\uB85C \uC0C1\uB300\uB97C \uADA4\uB6AB\uB294
      \uBB34\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894150
    m_Localized: "\uC678\uB0A0\uC758 \uAE34 \uC790\uB8E8\uB97C \uAC00\uC9C4 \uBB34\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894154
    m_Localized: "\uB4A4\uCABD\uB3C4 \uACAC\uC81C\uAC00\uB2A5\uD55C \uCC3D. \uD718\uB450\uB97C
      \uB54C \uADF8 \uC9C4\uAC00\uAC00 \uBC1C\uD718\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894156
    m_Localized: "\uB9DE\uC740 \uC0C1\uB300\uB97C \uB9C8\uBE44\uC2DC\uD0A4\uB294
      \uB3C5\uC774 \uBC1C\uB9B0 \uB2E8\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894163
    m_Localized: "\uC2DC\uC704\uB97C \uB2F9\uAE30\uBA74 \uAD49\uC74C\uACFC \uD568\uAED8
      \uD654\uC0B4? \uC774 \uB098\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894161
    m_Localized: "\uC0AC\uD30C\uC774\uC5B4\uAC00 \uBC15\uD600\uC788\uB294 \uB9C9\uB300\uAE30.
      \uC2E0\uBE44\uB85C\uC6B4 \uD798\uC774 \uB290\uAEF4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894165
    m_Localized: "\uD654\uC0B4\uC744 \uC274\uD2C8\uC5C6\uC774 \uBC1C\uC0AC\uD558\uB294
      \uC2E0\uC131\uD55C \uD65C."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894159
    m_Localized: "\uD53C\uAC00 \uBB3C\uB4E0 \uAC00\uC2DC\uAC00 \uBD80\uCC29\uB41C
      \uCC44\uCC0D. \uC870\uC2EC\uD574\uC11C \uB2E4\uB8E8\uC9C0 \uC54A\uC73C\uBA74
      \uC0AC\uC6A9\uC790\uB3C4 \uB2E4\uCE60 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894160
    m_Localized: "\uAD34\uC778 \uBBF8\uB178\uD0C0\uC6B0\uB974\uC2A4\uAC00 \uD718\uB458\uB800\uB2E4\uACE0
      \uC54C\uB824\uC9C4 \uB300\uAC80. \uBB34\uC2DD\uD558\uAC8C \uD070 \uCE7C\uB0A0\uB9CC\uD07C
      \uC5C4\uCCAD\uB09C \uBB34\uAC8C\uB97C \uC790\uB791\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894166
    m_Localized: "\uCC9C\uC0C1\uC758 \uD798\uC744 \uB2E4\uB8F0 \uC218 \uC788\uAC8C
      \uB418\uB294 \uAC74\uD2C0\uB9BF."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894164
    m_Localized: "\uBAA9\uC228\uC744 \uC21C\uC2DD\uAC04\uC5D0 \uC557\uC544\uAC00\uB294
      \uC7A5\uCD1D."
    m_Metadata:
      m_Items: []
  - m_Id: 32673007173894162
    m_Localized: "\uBCF4\uC774\uB294 \uBAA8\uB4E0\uAC83\uC744 \uD30C\uAD34\uD558\uB294
      \uB3C4\uB07C."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
