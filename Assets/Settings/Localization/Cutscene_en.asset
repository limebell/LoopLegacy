  m_TableData:
  - m_Id: 7127695360
    m_Localized: Long ago, a kingdom flourished in peace.
    m_Metadata:
      m_Items: []
  - m_Id: 269967949824
    m_Localized: "And now\u2014\r\nthe hero's journey begins."
    m_Metadata:
      m_Items: []
  - m_Id: 121686720512
    m_Localized: "\u201CTo thee, I bestow the name of Hero.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 129530068992
    m_Localized: 'Placing his final hope in a single warrior,

      the king sent
      him forth into the world.'
    m_Metadata:
      m_Items: []
  - m_Id: 101889605632
    m_Localized: "One day, darkness fell\u2014\r\nand with it came the Demon Lord.\r\nThe
      kingdom was plunged into despair."
    m_Metadata:
      m_Items: []
  - m_Id: 111125463040
    m_Localized: 'When all hope seemed lost,

      the king summoned one person.'
    m_Metadata:
      m_Items: []
  - m_Id: 92829908992
    m_Localized: But that peace did not last...
    m_Metadata:
      m_Items: []
