    m_Metadata:
      m_Items: []
  - m_Id: 1860075913740288
    m_Localized: "\uC635\uC158\uC744 \uC804\uBD80 \uCD08\uAE30\uAC12\uC73C\uB85C
      \uC124\uC815\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
