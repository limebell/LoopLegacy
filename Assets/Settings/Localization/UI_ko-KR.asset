    m_Localized: "\uC720\uBB3C\uC744 \uC774\uBBF8 \uCD5C\uB300 \uAC2F\uC218\uB9CC\uD07C
      \uBCF4\uC720\uC911\uC785\uB2C8\uB2E4.\\n\uBCF4\uC720\uC911\uC778 \uC720\uBB3C
      \uC911 \uD558\uB098\uB97C \uBC84\uB9AC\uAC70\uB098, \uBCF4\uC0C1\uC744 \uAC74\uB108\uB6F8
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 26345113703153664
    m_Localized: "\uD68D\uB4DD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 26351394673393664
    m_Localized: "\uC815\uB9D0 \uC720\uBB3C [{0}]\uC744(\uB97C) \uBC84\uB9AC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 26361431139549184
    m_Localized: "\uD22C\uC790\uD55C \uC2A4\uD0EF 1\uB2F9 \uCD5C\uB300 \uCCB4\uB825\uC774
      4 \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 26361457534304256
    m_Localized: "\uD22C\uC790\uD55C \uC2A4\uD0EF 1\uB2F9 ATK \uAC12\uC774 2 \uC99D\uAC00\uD55C\uB2E4.
      ATK \uAC12\uACFC \uBB34\uAE30\uC5D0 \uBE44\uB840\uD558\uC5EC \uD53C\uD574\uB7C9\uC774
      \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 26361468015869952
    m_Localized: "\uD22C\uC790\uD55C \uC2A4\uD0EF 1\uB2F9 DEF \uAC12\uC774 2 \uC99D\uAC00\uD55C\uB2E4.
      DEF \uAC12\uACFC \uBC29\uC5B4\uAD6C\uC5D0 \uBE44\uB840\uD558\uC5EC \uAC10\uC18C\uC728\uC774
      \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 26361475792109568
    m_Localized: "\uD22C\uC790\uD55C \uC2A4\uD0EF 1 \uB2F9 LUC \uAC12\uC774 1 \uC99D\uAC00\uD55C\uB2E4.
      LUC \uAC12\uC774 \uB192\uC544\uC9C8\uC218\uB85D \uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD588\uC744
      \uB54C \uC5BB\uB294 \uACE8\uB4DC\uC640 \uB4DC\uB78D\uB960\uC774 \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 26444538601537536
    m_Localized: "\uC7A5\uBE44 / \uBB34\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 26444568662114304
    m_Localized: "\uC7A5\uBE44 / \uBC29\uC5B4\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 26707586193031168
    m_Localized: "\uB2F9\uC2E0\uC744 \uC4F0\uB7EC\uB728\uB9B0 \uBAAC\uC2A4\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 27166884761174016
    m_Localized: "\uAC00\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 27167180560269312
    m_Localized: "\uAD6C\uB9E4\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 27370698407673856
    m_Localized: "\uC544\uBB34 \uACF3\uC774\uB098 \uD130\uCE58\uD574\uC11C \uACC4\uC18D\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 28128878859386880
    m_Localized: "\uB808\uBCA8"
    m_Metadata:
      m_Items: []
  - m_Id: 28133609447096320
    m_Localized: "\uBAAC\uC2A4\uD130 {0}\uC744(\uB97C) \uCC98\uD615!"
    m_Metadata:
      m_Items: []
  - m_Id: 28134190362394624
    m_Localized: "\uBAAC\uC2A4\uD130 {0}\uC758 \uACF5\uACA9\uC744 \uD68C\uD53C!"
    m_Metadata:
      m_Items: []
  - m_Id: 28240338130305024
    m_Localized: "\uB2F9\uC2E0\uC740 {0}\uC758 \uCCB4\uB825\uC744 \uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 28461574303252480
    m_Localized: "\uBB34\uAE30 [{0}]\uC744(\uB97C) \uD68D\uB4DD\uD588\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 28461621552087040
    m_Localized: "\uBC29\uC5B4\uAD6C [{0}]\uC744(\uB97C) \uD68D\uB4DD\uD588\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 28518157376815104
    m_Localized: "\uC720\uBB3C \uC218\uB7C9"
    m_Metadata:
      m_Items: []
  - m_Id: 28820963048554496
    m_Localized: "\uC774\uBBF8 \uCD5C\uB300 \uB808\uBCA8\uC5D0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 28998368853753856
    m_Localized: "\uC218\uC9D1\uD560 \uC218 \uC788\uB294 \uCD5C\uB300 \uC218\uB7C9\uC5D0
      \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 29231441503584256
    m_Localized: "\uBCC0\uACBD\uD55C \uC124\uC815\uC744 \uC800\uC7A5\uD558\uC9C0
      \uC54A\uACE0 \uC885\uB8CC\uD569\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 29699402739744768
    m_Localized: "\uB9AC\uB864 \uD69F\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 29699502971027456
    m_Localized: "\uB354 \uC774\uC0C1 \uB9AC\uB864 \uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 30100233142140928
    m_Localized: "\uC5C5\uADF8\uB808\uC774\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 30102143232376832
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC\uC744 \uC885\uB8CC\uD558\uACE0 \uAC8C\uC784\uC744
      \uC2DC\uC791\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 32537420672532480
    m_Localized: "! TIP\r\nHP\uC640 ATK, DEF\uB97C \uACE8\uACE0\uB8E8 \uD22C\uC790\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 32955290602700800
    m_Localized: "\uB2E4\uC74C \uC2DC\uC791 \uC2DC \uC120\uD0DD\uD55C \uC720\uBB3C\uC744
      \uBCF4\uC720\uD55C \uCC44\uB85C \uC2DC\uC791\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 32957053502226432
    m_Localized: "\uC720\uBB3C \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 32957159240630272
    m_Localized: "\uC720\uBB3C\uC744 \uBCF4\uC720\uD558\uC9C0 \uC54A\uC740 \uCC44\uB85C
      \uC2DC\uC791\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 32959400936734720
    m_Localized: "\uCD08\uAE30 \uC720\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 33195304511078400
    m_Localized: "\uC120\uD0DD \uAC00\uB2A5\uD55C \uCD5C\uB300 \uB4F1\uAE09"
    m_Metadata:
      m_Items: []
  - m_Id: 33250872609210368
    m_Localized: "\uC601\uC9C0\uAC00 \uCD5C\uB300 \uB808\uBCA8\uC5D0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 33577191591116800
    m_Localized: "\uC720\uBB3C [{0}]\uC744(\uB97C) \uD574\uAE08\uD588\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 33900048409952256
    m_Localized: "\uD504\uB9AC\uC14B"
    m_Metadata:
      m_Items: []
  - m_Id: 33926825492611072
    m_Localized: "\uC7A0\uAE40"
    m_Metadata:
      m_Items: []
  - m_Id: 33931786712514560
    m_Localized: "\uD544\uC694\uD55C \uC720\uBB3C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 33931799823908864
    m_Localized: "\uAD6C\uB9E4\uB97C \uC704\uD574 \uD544\uC694\uD55C \uC720\uBB3C\uC774
      \uCDA9\uBD84\uD788 \uD574\uAE08\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n\uD544\uC694:
      {0}, \uD604\uC7AC: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 33962375138246656
    m_Localized: "\uAC1C\uBC29\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 33962704948953088
    m_Localized: "\uBBF8\uAC1C\uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 33963161024987136
    m_Localized: "\uC774\uBBF8 \uAC1C\uBC29\uB41C \uC9C0\uB984\uAE38\uC785\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 33965356919291904
    m_Localized: "\uC9C0\uB984\uAE38 [{0}]\uC744 {1}G\uB97C \uB0B4\uACE0 \uAC1C\uBC29\uD569\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 35933482598793216
    m_Localized: "\uB85C\uB529\uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 36289904817733632
    m_Localized: "\uD2B9\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 37143597008027648
    m_Localized: "\uC720\uBB3C \uC2AC\uB86F\uC774 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4!\n\uBCF4\uC0C1\uC744
      \uD3EC\uAE30\uD558\uAC70\uB098, \uAE30\uC874 \uC720\uBB3C\uC744 \uBC84\uB824
      \uC2AC\uB86F\uC744 \uD655\uBCF4\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 37340677848694784
    m_Localized: "\uC774\uBC88\uC5D0 \uB4DC\uB78D\uB41C \uC544\uC774\uD15C"
    m_Metadata:
      m_Items: []
  - m_Id: 37347239275266048
    m_Localized: "...\uADF8\uB9AC\uACE0 {0}\uAC1C \uB354"
    m_Metadata:
      m_Items: []
  - m_Id: 37353289969827840
    m_Localized: "\uBA3C\uC800 \uD68D\uB4DD\uD558\uAC70\uB098 \uBC84\uB9B4 \uC720\uBB3C\uC744
      \uC120\uD0DD\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 37512391123533824
    m_Localized: "\uB3C4\uC11C\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 37512429102956544
    m_Localized: "\uC218\uC9D1 \uD604\uD669"
    m_Metadata:
      m_Items: []
  - m_Id: 37517554483724288
    m_Localized: "\uC801\uC6A9\uC911\uC778 \uD6A8\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 37517652773044224
    m_Localized: "\uAD00\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 37551958765600768
    m_Localized: "\uAC8C\uC784 \uC0C1\uD0DC\uC5D0 \uC624\uB958\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4.
      \uC601\uC9C0\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 37623214584102912
    m_Localized: "\uB204\uC801 \uB808\uBCA8"
    m_Metadata:
      m_Items: []
  - m_Id: 39033700634591232
    m_Localized: "\uC218\uC9D1\uD55C \uBB34\uAE30 \uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 39033724093333504
    m_Localized: "\uCD5C\uB300\uB85C \uC218\uC9D1\uD55C \uBB34\uAE30 \uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 38659287095443456
    m_Localized: "\uBE44\uB9E4\uD488"
    m_Metadata:
      m_Items: []
  - m_Id: 38659807281414144
    m_Localized: "\uD574\uB2F9 \uB808\uBCA8\uC758 \uC720\uBB3C\uC740 \uC0C1\uC810\uC5D0\uC11C
      \uD310\uB9E4\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 38716202651484160
